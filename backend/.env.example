# ============================================================
# Server Configuration
# ============================================================
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ============================================================
# Database Configuration (Supabase PostgreSQL Session Pooler)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# ============================================================
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# ============================================================
# Qdrant Vector Store Configuration
# Supported backends: 'local' (development backup) or 'qdrant_cloud'
# ============================================================
VECTOR_STORE_BACKEND=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================================
# Storage Configuration
# Supported backends: 'supabase' (production cloud) or 'local' (development/testing)
# In 'supabase' mode, cloud storage failure raises explicit errors (no silent fallback).
# ============================================================
STORAGE_BACKEND=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=documents
